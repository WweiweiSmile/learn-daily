# 复制成 .env 再填。真 key 只放 .env，这个文件永远留空。

# OpenAI 兼容的模型服务。DeepSeek 是默认值。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 空闲看门狗（秒）：两个数据块之间最长等多久。K3 这类推理模型一次要跑好几分钟，
# 别把它当成总超时。
LLM_IDLE_TIMEOUT=120

# 按天切分：攒到 TARGET 字收一天；单天不超过 MAX；最后一天不足 MIN 就并进前一天。
DAY_TARGET_CHARS=6000
DAY_MAX_CHARS=12000
DAY_MIN_CHARS=1500

# ---------- 认证（call-auth 认证中心）----------
# 本服务是**资源服务**：只验签、不签发。身份来自 access token 的 claims，
# 不查库；数据按 sub（用户 id）物理分库到 data/users/{id}.db。
# 不配这些也能跑（代码里有默认值），但默认值指向 localhost，别把生产也落到那儿。
AUTH_JWKS_URL=http://localhost:8020/.well-known/jwks.json
AUTH_ISSUER=call-auth
AUTH_AUDIENCE=learn-daily
AUTH_LEEWAY_SECONDS=60
AUTH_JWKS_TIMEOUT=10

# 允许的前端源，逗号分隔。留空则放行所有来源（仅开发方便）
CORS_ORIGINS=
