{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "baseUrl": ".",
    "rootDir": ".",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    // 跳过 node_modules 里第三方 .d.ts 的类型检查：@tarojs 的声明文件引用了没装的
    // react-native 类型，不跳过的话 tsc 会被一堆与业务无关的报错淹没，也就没人拿它当门禁了。
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["./src", "./types"],
  "compileOnSave": false
}
